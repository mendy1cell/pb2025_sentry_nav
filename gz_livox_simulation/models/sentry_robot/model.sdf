<?xml version="1.0"?>
<sdf version="1.9">
  <model name="sentry_robot" canonical_link="base_link">
    <static>false</static>
    <frame name="base_footprint" attached_to="base_link">
      <pose relative_to="__model__">0 0 0 0 0 0</pose>
    </frame>
    <link name="base_link">
      <pose>0 0 0.10 0 0 0</pose>
      <inertial>
        <mass>20</mass>
        <inertia><ixx>0.17</ixx><iyy>0.17</iyy><izz>0.29</izz></inertia>
      </inertial>
      <!-- Simplified omnidirectional chassis. The drive applies bounded
           forces, so ground and obstacle contacts remain owned by Physics.
           Nine r=0.06 spheres span the same 0.30 x 0.30 x 0.12 envelope as
           a box. A box collision sinks ~15 cm into the arena's slope/step
           trimesh under Bullet (its edges and faces get no stable contact
           there), while sphere-vs-trimesh contacts stay on the surface. -->
      <collision name="contact_corner_fl">
        <pose>0.09 0.09 0 0 0 0</pose>
        <geometry><sphere><radius>0.06</radius></sphere></geometry>
        <surface><friction><ode><mu>0.01</mu><mu2>0.01</mu2></ode></friction></surface>
      </collision>
      <collision name="contact_corner_fr">
        <pose>0.09 -0.09 0 0 0 0</pose>
        <geometry><sphere><radius>0.06</radius></sphere></geometry>
        <surface><friction><ode><mu>0.01</mu><mu2>0.01</mu2></ode></friction></surface>
      </collision>
      <collision name="contact_corner_rl">
        <pose>-0.09 0.09 0 0 0 0</pose>
        <geometry><sphere><radius>0.06</radius></sphere></geometry>
        <surface><friction><ode><mu>0.01</mu><mu2>0.01</mu2></ode></friction></surface>
      </collision>
      <collision name="contact_corner_rr">
        <pose>-0.09 -0.09 0 0 0 0</pose>
        <geometry><sphere><radius>0.06</radius></sphere></geometry>
        <surface><friction><ode><mu>0.01</mu><mu2>0.01</mu2></ode></friction></surface>
      </collision>
      <collision name="contact_edge_f">
        <pose>0.09 0 0 0 0 0</pose>
        <geometry><sphere><radius>0.06</radius></sphere></geometry>
        <surface><friction><ode><mu>0.01</mu><mu2>0.01</mu2></ode></friction></surface>
      </collision>
      <collision name="contact_edge_r">
        <pose>-0.09 0 0 0 0 0</pose>
        <geometry><sphere><radius>0.06</radius></sphere></geometry>
        <surface><friction><ode><mu>0.01</mu><mu2>0.01</mu2></ode></friction></surface>
      </collision>
      <collision name="contact_edge_l">
        <pose>0 0.09 0 0 0 0</pose>
        <geometry><sphere><radius>0.06</radius></sphere></geometry>
        <surface><friction><ode><mu>0.01</mu><mu2>0.01</mu2></ode></friction></surface>
      </collision>
      <collision name="contact_edge_rt">
        <pose>0 -0.09 0 0 0 0</pose>
        <geometry><sphere><radius>0.06</radius></sphere></geometry>
        <surface><friction><ode><mu>0.01</mu><mu2>0.01</mu2></ode></friction></surface>
      </collision>
      <collision name="contact_center">
        <pose>0 0 0 0 0 0</pose>
        <geometry><sphere><radius>0.06</radius></sphere></geometry>
        <surface><friction><ode><mu>0.01</mu><mu2>0.01</mu2></ode></friction></surface>
      </collision>
      <visual name="base_visual">
        <pose>0 0 0.05 0 0 1.57079632679</pose>
        <geometry><box><size>0.2 0.3 0.1</size></box></geometry>
        <material><diffuse>1 0.45 0.05 1</diffuse></material>
      </visual>
      <visual name="front_left_wheel">
        <pose>0.1 0.13 0 -1.57079632679 0 0</pose>
        <geometry><cylinder><radius>0.06</radius><length>0.05</length></cylinder></geometry>
        <material><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
      <visual name="rear_left_wheel">
        <pose>-0.1 0.13 0 -1.57079632679 0 0</pose>
        <geometry><cylinder><radius>0.06</radius><length>0.05</length></cylinder></geometry>
        <material><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
      <visual name="front_right_wheel">
        <pose>0.1 -0.13 0 -1.57079632679 0 0</pose>
        <geometry><cylinder><radius>0.06</radius><length>0.05</length></cylinder></geometry>
        <material><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
      <visual name="rear_right_wheel">
        <pose>-0.1 -0.13 0 -1.57079632679 0 0</pose>
        <geometry><cylinder><radius>0.06</radius><length>0.05</length></cylinder></geometry>
        <material><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
      <!-- Sensors belong to the same rigid body. Massless semantic frames
           avoid ill-conditioned fixed joints and spurious IMU accelerations. -->
      <sensor name="mid360_imu" type="imu">
        <pose>-0.011 -0.02329 0.70412 0 0 0</pose>
        <always_on>true</always_on>
        <!-- Match the arena's 2 ms physics step; 100 Hz aliases the contact
             solver's small angular oscillations at the elevated IMU mount. -->
        <update_rate>500</update_rate>
        <topic>/livox/imu</topic>
        <gz_frame_id>imu_link</gz_frame_id>
      </sensor>
      <!-- Mounted inverted on the big yaw like the real car: rays are cast
           along the flipped device axes (roll pi, so the -7..52 deg Mid-360
           elevation band looks down), and install_attitude_rpy rotates the
           published points back upright, matching the driver's roll-180
           install attitude. lidar_link therefore stays identity. -->
      <sensor name="livox_csv_raycast" type="custom">
        <pose>0 0 0.66 3.14159265358979 0 0</pose>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <topic>/livox/lidar</topic>
        <plugin filename="libgz_livox_raycast_system.so" name="gz_livox_simulation::LivoxRaycastSystem">
          <csv_file_name>package://ros2_livox_simulation/scan_mode/mid360.csv</csv_file_name>
          <samples>30000</samples>
          <downsample>5</downsample>
          <min_range>0.1</min_range>
          <max_range>200.0</max_range>
          <scan_rate_hz>10</scan_rate_hz>
          <install_attitude_rpy>3.14159265358979 0 0</install_attitude_rpy>
          <frame_id>lidar_link</frame_id>
          <topic>/livox/lidar</topic>
        </plugin>
      </sensor>
    </link>
    <frame name="imu_link" attached_to="base_link">
      <pose relative_to="base_link">-0.011 -0.02329 0.70412 0 0 0</pose>
    </frame>
    <frame name="lidar_link" attached_to="base_link">
      <pose relative_to="base_link">0 0 0.66 0 0 0</pose>
    </frame>

    <plugin filename="libgz_holonomic_pose_system.so" name="gz_livox_simulation::HolonomicPoseSystem">
      <topic>/cmd_vel_chassis</topic>
      <command_timeout>0.5</command_timeout>
      <velocity_gain>20</velocity_gain>
      <velocity_integral_gain>100</velocity_integral_gain>
      <max_acceleration>6</max_acceleration>
      <max_angular_acceleration>6</max_angular_acceleration>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
  </model>
</sdf>
