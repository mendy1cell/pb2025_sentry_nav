<?xml version="1.0"?>
<sdf version="1.9">
  <world name="empty_livox">
    <physics name="1ms" type="ignored"><max_step_size>0.001</max_step_size><real_time_factor>1</real_time_factor></physics>
    <gravity>0 0 -9.81</gravity>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <model name="ground_plane">
      <static>true</static>
      <link name="ground">
        <collision name="ground"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry></collision>
        <visual name="ground"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry></visual>
      </link>
    </model>
    <include>
      <uri>model://sentry_robot</uri>
      <pose>6.35 7.6 0.2 0 0 0</pose>
    </include>
  </world>
</sdf>
